<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
  </ItemGroup>

  <!-- The diagnostic catalog tests compare the descriptors with the release-tracking files and the generator README. -->
  <ItemGroup>
    <None Include="../../source-generators/CheatEngine.Client.SourceGenerators.Lua/AnalyzerReleases.Shipped.md"
          Link="Diagnostics/AnalyzerReleases.Shipped.md" CopyToOutputDirectory="PreserveNewest"/>
    <None Include="../../source-generators/CheatEngine.Client.SourceGenerators.Lua/AnalyzerReleases.Unshipped.md"
          Link="Diagnostics/AnalyzerReleases.Unshipped.md" CopyToOutputDirectory="PreserveNewest"/>
    <None Include="../../source-generators/CheatEngine.Client.SourceGenerators.Lua/README.md"
          Link="Diagnostics/Generator.README.md" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

  <!--
    The real SDK generator composes with Client's generator. Source builds copy the submodule generator and its Shared
    dependency as normal assembly references; production builds test the generator from the reviewed SDK package.
  -->
  <ItemGroup Condition="'$(CheatEngineSdkSourceMode)' != 'true'">
    <AssemblyMetadata Include="CheatEngine.Client.Tests.SdkGeneratorDirectory"
                      Value="$(NuGetPackageRoot)cheatengine.sdk/$(CheatEngineSdkVersion)/analyzers/dotnet/cs"/>
    <AssemblyMetadata Include="CheatEngine.Client.Tests.SdkVersion" Value="$(CheatEngineSdkVersion)"/>
  </ItemGroup>

  <ItemGroup Condition="'$(CheatEngineSdkSourceMode)' == 'true'">
    <ProjectReference Include="$(_CheatEngineSdkSourceDirectory)source-generators/CheatEngine.SDK.SourceGenerators.LuaBindings/CheatEngine.SDK.SourceGenerators.LuaBindings.csproj"/>
  </ItemGroup>
  <Target Name="CheatEngineClientSourceGeneratorTestIdentity" BeforeTargets="GetAssemblyAttributes"
          Condition="'$(CheatEngineSdkSourceMode)' == 'true'">
    <ItemGroup>
      <AssemblyMetadata Include="CheatEngine.Client.Tests.SdkGeneratorDirectory" Value="$(TargetDir)"/>
      <AssemblyMetadata Include="CheatEngine.Client.Tests.SdkGeneratorKind" Value="source"/>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="../../source-generators/CheatEngine.Client.SourceGenerators.Lua/CheatEngine.Client.SourceGenerators.Lua.csproj"/>
    <ProjectReference Include="../../libs/CheatEngine.Client.Abstractions/CheatEngine.Client.Abstractions.csproj"/>
    <ProjectReference Include="../../libs/CheatEngine.Client.Extensions.DependencyInjection/CheatEngine.Client.Extensions.DependencyInjection.csproj"/>
  </ItemGroup>

</Project>

<Project>

  <PropertyGroup>
    <!--
      Each fixture is a managed plugin component with its own intact output directory. The SDK/host chooses any
      load-context policy. The source fixture deliberately consumes the current Client graph by project reference, so
      it cannot claim to be a Client package-consumer test. It imports the deployment target only to stage and check a
      fresh, complete output closure when an explicit fixture bundle path is supplied.
    -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>
    <CheatEngineClientPluginProject>true</CheatEngineClientPluginProject>
    <CheatEngineClientSkipPluginProjectValidation>true</CheatEngineClientSkipPluginProjectValidation>
    <!-- The default follows the repository pin (eng/CheatEngineSdk.props); the fixtures stay out of Central Package Management. -->
    <CoexistenceSdkPackageVersion Condition="'$(CoexistenceSdkPackageVersion)' == ''">$(CheatEngineSdkVersion)</CoexistenceSdkPackageVersion>
    <!--
      A version other than the pinned tuple is an operator-supplied qualification input, not a lock-file update: its
      restore records the candidate closure in a lock file under obj/ and never rewrites the committed one. Lock files
      stay enabled, because disabling them while a committed lock file exists fails the restore (NU1005).
    -->
    <NuGetLockFilePath Condition="'$(CoexistenceSdkPackageVersion)' != '$(CheatEngineSdkVersion)'">$(MSBuildProjectExtensionsPath)coexistence-candidate.packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exercise the changed Client source graph; a future package smoke remains the package-consumer gate. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\libs\CheatEngine.Client.Hosting\CheatEngine.Client.Hosting.csproj"/>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\source-generators\CheatEngine.Client.SourceGenerators.Lua\CheatEngine.Client.SourceGenerators.Lua.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"/>
    <!-- Keep the SDK direct package reference: it supplies the entry-point generator and bridge assets. -->
    <PackageReference Include="CheatEngine.SDK" Version="$(CoexistenceSdkPackageVersion)"/>
    <Compile Include="../CoexistenceDiagnostics.cs" Link="CoexistenceDiagnostics.cs"/>
  </ItemGroup>

  <!-- Use the same complete-closure deployment mechanics as the Hosting package without misrepresenting this
       source-graph fixture as an isolated Client package consumer. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\libs\CheatEngine.Client.Hosting\buildTransitive\CheatEngine.Client.Hosting.targets"/>

</Project>

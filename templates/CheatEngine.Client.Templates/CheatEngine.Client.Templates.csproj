<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <Description>dotnet new template for an in-process, dependency-injection-first Cheat Engine plugin built on CheatEngine.Client and CheatEngine.SDK.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="**/*"/>
    <Content Include="content/**/*" Pack="true" PackagePath="content/"/>
    <None Include="README.md" Pack="true" PackagePath="/"/>
  </ItemGroup>

</Project>

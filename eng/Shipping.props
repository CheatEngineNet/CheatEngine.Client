<Project>
  <!-- Profile for src/ and libs/: the assemblies a consumer builds against. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      Trim and AOT posture, aligned with CheatEngine.SDK's shipping profile. IsAotCompatible already implies IsTrimmable,
      EnableTrimAnalyzer, EnableAotAnalyzer and EnableSingleFileAnalyzer; they are restated so the guarantee survives a
      change to what IsAotCompatible implies, and restating them changes nothing today. VerifyReferenceTrimCompatibility
      is the one property here that changes behavior: it is a distinct opt-in from VerifyReferenceAotCompatibility
      (IL3058) that reports IL2125 for a referenced assembly not marked trimmable (IsTrimmable assembly metadata). The
      shipping projects build without IL2125: the Client projects, the pinned CheatEngine.SDK and the Microsoft.Extensions
      packages of Directory.Packages.props all declare it. Never silence IL2125 globally: a new non-trimmable reference is
      removed or documented where it is referenced. CHEATENGINECLIENT9004, 9005 and 9008 (Directory.Build.targets) refuse
      a pack that turns off IsAotCompatible or either reference verification.
      https://learn.microsoft.com/dotnet/core/deploying/trimming/prepare-libraries-for-trimming
    -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
    <VerifyReferenceTrimCompatibility>true</VerifyReferenceTrimCompatibility>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
    <EnableStrictModeForBaselineValidation>true</EnableStrictModeForBaselineValidation>
    <!--
      Baseline hook: nothing is published yet, so there is no version to compare with. After the first release, set
      CheatEngineClientPackageValidationBaselineVersion in Directory.Build.props to that version; package validation then
      also reports breaking changes against the published packages (RELEASING.md).
      https://learn.microsoft.com/dotnet/core/project-sdk/msbuild-props#packagevalidationbaselineversion
    -->
    <PackageValidationBaselineVersion Condition="'$(CheatEngineClientPackageValidationBaselineVersion)' != ''">$(CheatEngineClientPackageValidationBaselineVersion)</PackageValidationBaselineVersion>
    <!-- Same folder as the CI Release leg and the package smoke tests. -->
    <PackageOutputPath>$(ArtifactsPath)/nuget</PackageOutputPath>
    <PackageTags>cheat-engine;plugin;memory;dotnet;fluent;dependency-injection</PackageTags>
  </PropertyGroup>

  <!--
    SPDX 2.2 software bill of materials embedded in every package at _manifest/spdx_2.2/manifest.spdx.json, generated
    locally and in CI alike so both inventories match. Microsoft.Sbom.Targets writes it after Pack and re-zips the .nupkg
    (never the .snupkg). Directory.Build.targets sets the SBOM package version from MinVer and refuses a pack without
    the SBOM (CHEATENGINECLIENT9021). eng/Templates.props carries the same values.
  -->
  <PropertyGroup Label="Software bill of materials">
    <GenerateSBOM>true</GenerateSBOM>
    <SbomGenerationPackageSupplier>CheatEngineNet</SbomGenerationPackageSupplier>
    <SbomGenerationNamespaceBaseUri>https://github.com/CheatEngineNet/CheatEngine.Client</SbomGenerationNamespaceBaseUri>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Sbom.Targets" PrivateAssets="all"/>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers"
                      PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"/>
    <!-- Each modular package publishes the README beside its project. The root README is
         the showcase for the aggregate package, not a substitute for a package contract. -->
    <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="/" Visible="false"/>
  </ItemGroup>

</Project>

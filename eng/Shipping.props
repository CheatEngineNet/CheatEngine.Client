<Project>
  <!-- Profile for src/ and libs/: the assemblies a consumer builds against. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
    <EnableStrictModeForBaselineValidation>true</EnableStrictModeForBaselineValidation>
    <!--
      Baseline hook: nothing is published yet, so there is no version to compare with. After the first release, set
      CheatEngineClientPackageValidationBaselineVersion in Directory.Build.props to that version; package validation then
      also reports breaking changes against the published packages (RELEASING.md).
      https://learn.microsoft.com/dotnet/core/project-sdk/msbuild-props#packagevalidationbaselineversion
    -->
    <PackageValidationBaselineVersion Condition="'$(CheatEngineClientPackageValidationBaselineVersion)' != ''">$(CheatEngineClientPackageValidationBaselineVersion)</PackageValidationBaselineVersion>
    <!-- Same folder as the CI Release leg and the package smoke tests. -->
    <PackageOutputPath>$(ArtifactsPath)/nuget</PackageOutputPath>
    <PackageTags>cheat-engine;plugin;memory;dotnet;fluent;dependency-injection</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers"
                      PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"/>
    <!-- Each modular package publishes the README beside its project. The root README is
         the showcase for the aggregate package, not a substitute for a package contract. -->
    <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="/" Visible="false"/>
  </ItemGroup>

</Project>

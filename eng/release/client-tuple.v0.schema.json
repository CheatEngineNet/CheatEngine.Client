{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CheatEngineNet/CheatEngine.Client/blob/main/eng/release/client-tuple.v0.schema.json",
  "title": "CheatEngine.Client release tuple",
  "description": "What one Client release is: the seven packages, the exact CheatEngine.SDK package they consume, the Cheat Engine profile they target, how they were built, attested and published. The release workflow writes it as CheatEngine.Client.<version>.tuple.json: stage PrePublish on the draft release, stage Published once nuget.org serves the packages. A compatibility issue is tied to one tuple, never to a tag name alone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "stage",
    "source",
    "build",
    "ceProfile",
    "qualification",
    "sbom",
    "attestations",
    "assets",
    "client",
    "consumedSdk",
    "createdUtc"
  ],
  "properties": {
    "schema": {
      "const": "cheatengine-client-tuple/v0"
    },
    "stage": {
      "enum": [
        "PrePublish",
        "Published"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "commit",
        "treeHash",
        "pullRequest",
        "releaseRunUrl",
        "ciRunUrl"
      ],
      "properties": {
        "repository": {
          "const": "CheatEngineNet/CheatEngine.Client"
        },
        "tag": {
          "type": "string",
          "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
        },
        "commit": {
          "$ref": "#/$defs/gitObject"
        },
        "treeHash": {
          "$ref": "#/$defs/gitObject"
        },
        "pullRequest": {
          "description": "The pull request whose squash merge produced the commit; null when none is associated.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "number",
            "headSha"
          ],
          "properties": {
            "number": {
              "type": "integer"
            },
            "headSha": {
              "$ref": "#/$defs/gitObject"
            }
          }
        },
        "releaseRunUrl": {
          "$ref": "#/$defs/runUrl"
        },
        "ciRunUrl": {
          "$ref": "#/$defs/runUrl"
        }
      }
    },
    "build": {
      "description": "The subset of the CI build-info.json that identifies the build environment.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dotnetSdk",
        "globalJsonSha256",
        "runner",
        "roslynFloor",
        "analysisLevel"
      ],
      "properties": {
        "dotnetSdk": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "globalJsonSha256": {
          "$ref": "#/$defs/sha256"
        },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "imageOs",
            "imageVersion"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "imageOs": {
              "type": "string",
              "minLength": 1
            },
            "imageVersion": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "roslynFloor": {
          "description": "CheatEngineClientRoslynComponentFloor: the Roslyn version the packed Lua generator is compiled against.",
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "analysisLevel": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ceProfile": {
      "description": "The Cheat Engine host profile of the consumed SDK; the Lua module, runtime configuration and load profile are recorded in that profile.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "supportProfileSha256"
      ],
      "properties": {
        "profileId": {
          "const": "ce-7.7.0.10621-x64-managed-hostfxr"
        },
        "supportProfileSha256": {
          "description": "SHA-256 of the Client support profile; null until the Client qualification documents exist.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrixSha256",
        "receipts"
      ],
      "properties": {
        "matrixSha256": {
          "description": "SHA-256 of the Client qualification matrix; null until it exists.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "receipts": {
          "description": "Committed host receipts (C3/C4) for this tree and package. Empty means no host scenario was run.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "receiptId",
              "qualificationId",
              "level",
              "status",
              "sha256"
            ],
            "properties": {
              "receiptId": {
                "type": "string",
                "pattern": "^R-[0-9]{8}T[0-9]{6}Z-Q[0-9]{2}(\\.[a-z])?-[0-9a-f]{8}$"
              },
              "qualificationId": {
                "type": "string",
                "pattern": "^Q(0[1-9]|[1-3][0-9]|4[0-8])(\\.[a-z])?$"
              },
              "level": {
                "enum": [
                  "C3",
                  "C4"
                ]
              },
              "status": {
                "enum": [
                  "NotExecuted",
                  "Passed",
                  "Failed",
                  "NotApplicable"
                ]
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    },
    "sbom": {
      "description": "The SPDX document embedded in each package, extracted and attested.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "spdxVersion",
        "attested",
        "documents"
      ],
      "properties": {
        "entry": {
          "const": "_manifest/spdx_2.2/manifest.spdx.json"
        },
        "spdxVersion": {
          "const": "SPDX-2.2"
        },
        "attested": {
          "type": "boolean"
        },
        "documents": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "sha256"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/packageId"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    },
    "attestations": {
      "description": "The sigstore bundles attached to the release: one build provenance attestation over the seven packages, one SBOM attestation per package.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenanceBundle",
        "sbomBundles"
      ],
      "properties": {
        "provenanceBundle": {
          "$ref": "#/$defs/bundleName"
        },
        "sbomBundles": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "bundle"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/packageId"
              },
              "bundle": {
                "$ref": "#/$defs/bundleName"
              }
            }
          }
        }
      }
    },
    "assets": {
      "description": "Every release asset except SHA256SUMS and this tuple, with the SHA-256 that SHA256SUMS lists.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "packages"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "packages": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "attestedAssetSha256",
              "contentHashSha512",
              "nugetOrgSignedSha256",
              "snupkgSha256"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/packageId"
              },
              "version": {
                "$ref": "#/$defs/version"
              },
              "attestedAssetSha256": {
                "description": "SHA-256 of the unsigned .nupkg that CI built, tested and attested, attached to the GitHub release.",
                "$ref": "#/$defs/sha256"
              },
              "contentHashSha512": {
                "description": "The NuGet SHA-512 base64 content hash of the unsigned package: the value a consumer's packages.lock.json records once nuget.org serves the repository-signed file.",
                "$ref": "#/$defs/sha512"
              },
              "nugetOrgSignedSha256": {
                "description": "SHA-256 of the repository-signed .nupkg nuget.org serves; null before publication.",
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              },
              "snupkgSha256": {
                "description": "SHA-256 of the symbol package; null for the packages without build output (the CheatEngine.Client facade and the template package).",
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "consumedSdk": {
      "description": "Copied from eng/sdk/consumed-sdk.json (same field names); contentHashSha512 is read from the lock file named by lockFile.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "range",
        "contentHashSha512",
        "attestedAssetSha256",
        "nugetOrgSignedSha256",
        "sourceCommit",
        "nativeBridge",
        "lockFile"
      ],
      "properties": {
        "id": {
          "const": "CheatEngine.SDK"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "range": {
          "type": "string",
          "pattern": "^\\[[0-9]+\\.[0-9]+\\.[0-9]+, [0-9]+\\.[0-9]+\\.[0-9]+\\)$"
        },
        "contentHashSha512": {
          "description": "The NuGet SHA-512 base64 content hash read from the lock file.",
          "$ref": "#/$defs/sha512"
        },
        "attestedAssetSha256": {
          "$ref": "#/$defs/sha256"
        },
        "nugetOrgSignedSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceCommit": {
          "$ref": "#/$defs/gitObject"
        },
        "nativeBridge": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "sourceFingerprint"
          ],
          "properties": {
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "sourceFingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}:[0-9a-f]{64}$"
            }
          }
        },
        "lockFile": {
          "const": "libs/CheatEngine.Client.Core/packages.lock.json"
        }
      }
    },
    "createdUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha512": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "packageId": {
      "enum": [
        "CheatEngine.Client",
        "CheatEngine.Client.Abstractions",
        "CheatEngine.Client.Core",
        "CheatEngine.Client.Extensions.DependencyInjection",
        "CheatEngine.Client.Fluent",
        "CheatEngine.Client.Hosting",
        "CheatEngine.Client.Templates"
      ]
    },
    "bundleName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.sigstore\\.json$"
    },
    "runUrl": {
      "type": "string",
      "pattern": "^https://github\\.com/CheatEngineNet/CheatEngine\\.Client/actions/runs/[0-9]+(/attempts/[0-9]+)?$"
    }
  }
}

<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>false</IsAotCompatible>
    <PackageOutputPath>$(ArtifactsPath)/packages</PackageOutputPath>
    <PackageDescription>dotnet new template for an in-process, dependency-injection-first Cheat Engine plugin.</PackageDescription>
    <PackageTags>dotnet-new;template;cheat-engine;plugin</PackageTags>
  </PropertyGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CheatEngine.Client</RootNamespace>
    <Description>Contracts, requests, failures and value vocabulary of CheatEngine.Client: the public types a Cheat Engine plugin or library references without taking the implementation.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(CheatEngineSdkEngineProject)" Condition="'$(CheatEngineSdkSourceMode)' == 'true'"/>
    <ProjectReference Include="$(CheatEngineSdkHostingProject)" Condition="'$(CheatEngineSdkSourceMode)' == 'true'"/>
    <PackageReference Include="CheatEngine.SDK" Condition="'$(CheatEngineSdkSourceMode)' != 'true'"
                      VersionOverride="$(CheatEngineSdkVersionRange)"
                      IncludeAssets="compile;runtime"
                      ExcludeAssets="build;buildTransitive;analyzers;native;contentFiles"/>
  </ItemGroup>

</Project>

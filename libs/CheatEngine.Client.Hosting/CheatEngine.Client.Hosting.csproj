<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectGuid>{CF0D14B3-B4CB-4BDD-91AD-4C8B6B8BBCD0}</ProjectGuid>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_CheatEngineClientHostingPackLuaGenerator</TargetsForTfmSpecificContentInPackage>
    <Description>The CheatEngineClientPlugin base class and one-provider-per-activation host for in-process Cheat Engine plugins, with the Lua module source generator and the plugin project checks.</Description>
  </PropertyGroup>

  <!-- A no-build pack consumes already-built analyzer output without asking the SDK to build project references. -->
  <PropertyGroup Condition="'$(NoBuild)' == 'true'">
    <BuildProjectReferences>false</BuildProjectReferences>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../CheatEngine.Client.Extensions.DependencyInjection/CheatEngine.Client.Extensions.DependencyInjection.csproj"/>
    <!-- A compiler component only: it never becomes a Hosting runtime dependency. -->
    <ProjectReference Include="../../source-generators/CheatEngine.Client.SourceGenerators.Lua/CheatEngine.Client.SourceGenerators.Lua.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      PackAsAnalyzer="true"/>
    <PackageReference Include="CheatEngine.SDK"
                      VersionOverride="$(CheatEngineSdkVersionRange)"
                      IncludeAssets="compile;runtime"
                      ExcludeAssets="build;buildTransitive;analyzers;native;contentFiles"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    <PackageReference Include="Microsoft.Extensions.Logging"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive/CheatEngine.Client.Hosting.props" Pack="true" PackagePath="buildTransitive/"/>
    <None Include="buildTransitive/CheatEngine.Client.Hosting.targets" Pack="true" PackagePath="buildTransitive/"/>
  </ItemGroup>

  <!-- Pack only the generator's own DLL. Roslyn supplies its compiler dependencies at consumer build time. -->
  <Target Name="_CheatEngineClientHostingPackLuaGenerator" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(Analyzer-&gt;WithMetadataValue('PackAsAnalyzer', 'true'))"
                              PackagePath="analyzers/dotnet/cs"/>
    </ItemGroup>
  </Target>

</Project>

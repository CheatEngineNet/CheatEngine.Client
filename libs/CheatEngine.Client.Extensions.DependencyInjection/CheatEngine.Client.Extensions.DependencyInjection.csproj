<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <Description>Microsoft.Extensions.DependencyInjection registrations for CheatEngine.Client: the activation-scoped client, modules, memory codecs and validated options.</Description>
    <!-- DI composes the experimental Client APIs (CECLIENT5001 value scans, CECLIENT5002 allocations); only Core, DI and tests may suppress them (ClientExperimentalDiagnosticsTests). -->
    <NoWarn>$(NoWarn);CECLIENT5001;CECLIENT5002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CheatEngine.Client.Hosting"/>
    <InternalsVisibleTo Include="CheatEngine.Client.Hosting.Tests"/>
    <ProjectReference Include="../CheatEngine.Client.Abstractions/CheatEngine.Client.Abstractions.csproj"/>
    <ProjectReference Include="../CheatEngine.Client.Core/CheatEngine.Client.Core.csproj"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    <PackageReference Include="Microsoft.Extensions.Logging"/>
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions"/>
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations"/>
  </ItemGroup>

</Project>

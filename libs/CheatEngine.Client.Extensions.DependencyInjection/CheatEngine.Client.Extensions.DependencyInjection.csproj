<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <Description>Microsoft.Extensions.DependencyInjection registrations for CheatEngine.Client, the composition layer of CheatEngine.Client.Hosting: the activation-scoped client, modules and validated options.</Description>
    <!-- DI composes every experimental Client API (CECLIENT5001 value scans, CECLIENT5002 allocations, CECLIENT5003 instructions, CECLIENT5004 Auto Assembler patches) and suppresses them here, never file by file; only Core, DI and tests may suppress them (ClientExperimentalDiagnosticsTests). -->
    <NoWarn>$(NoWarn);CECLIENT5001;CECLIENT5002;CECLIENT5003;CECLIENT5004</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The experimental ids are declared once, in Abstractions; the EnableAutoAssemblerPatches attribute uses them. -->
    <Compile Include="../CheatEngine.Client.Abstractions/ClientExperimentalDiagnostics.cs" Link="ClientExperimentalDiagnostics.cs"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CheatEngine.Client.Hosting"/>
    <InternalsVisibleTo Include="CheatEngine.Client.Hosting.Tests"/>
    <ProjectReference Include="../CheatEngine.Client.Abstractions/CheatEngine.Client.Abstractions.csproj"/>
    <ProjectReference Include="../CheatEngine.Client.Core/CheatEngine.Client.Core.csproj"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    <PackageReference Include="Microsoft.Extensions.Logging"/>
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions"/>
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations"/>
  </ItemGroup>

</Project>

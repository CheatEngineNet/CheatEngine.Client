<Project>
  <!-- Root defaults for every project. The only Directory.Build.props of the repository: nested ones would hide what a project inherits. -->

  <PropertyGroup Label="Layout">
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <!-- bin/, obj/ and test output live under artifacts/, so project folders hold sources only. -->
    <ArtifactsPath>$(RepoRoot)artifacts</ArtifactsPath>
  </PropertyGroup>

  <PropertyGroup Label="Language">
    <!-- An explicit number, never latest or preview. -->
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Pinned so a newer SDK band cannot add CA/IDE errors; raise it together with global.json (guard CHEATENGINECLIENT9030). -->
    <_CheatEngineClientPinnedAnalysisLevel>10.0-recommended</_CheatEngineClientPinnedAnalysisLevel>
    <AnalysisLevel>$(_CheatEngineClientPinnedAnalysisLevel)</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- NuGet audit policy (https://learn.microsoft.com/nuget/concepts/auditing-packages), guarded by CHEATENGINECLIENT9031.
       High (NU1903) and critical (NU1904) advisories fail every restore and build through TreatWarningsAsErrors. Suppress an
       advisory only with <NuGetAuditSuppress Include="<advisory URL>"/> plus a comment giving the justification and an expiry
       date, never on the release path. -->
  <PropertyGroup Label="Supply chain">
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <_CheatEngineClientNuGetAuditCodes>NU1900;NU1901;NU1902;NU1903;NU1904;NU1905</_CheatEngineClientNuGetAuditCodes>
    <!-- Ordinary builds: audit-source outages and low/moderate advisories are reported but do not block; high and critical advisories fail through TreatWarningsAsErrors. -->
    <WarningsNotAsErrors Condition="'$(AuditPipeline)' != 'true'">$(WarningsNotAsErrors);NU1900;NU1901;NU1902;NU1905</WarningsNotAsErrors>
    <!-- Dedicated audit run (restore -p:AuditPipeline=true, scheduled-health.yml): every audit code is an error. -->
    <WarningsAsErrors Condition="'$(AuditPipeline)' == 'true'">$(WarningsAsErrors);$(_CheatEngineClientNuGetAuditCodes)</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="Package identity">
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>CheatEngineNet</Authors>
    <Company>CheatEngineNet</Company>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/CheatEngineNet/CheatEngine.Client</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Label="Packaging and versioning">
    <!--
      The Roslyn version the shipped Lua generator (packed inside CheatEngine.Client.Hosting) is compiled against. A
      generator built against Roslyn N does not load in an older compiler (CS9057), so this floor, the
      Microsoft.CodeAnalysis pins in Directory.Packages.props, the template sdk-version constraint and global.json move
      together; CHEATENGINECLIENT9020 enforces the first two.
    -->
    <CheatEngineClientRoslynComponentFloor>5.9.0</CheatEngineClientRoslynComponentFloor>
  </PropertyGroup>

  <!-- Friend assemblies by convention: <Project> and tests/<Project>.Tests are twins. Keyed on the project name only, so the props phase is early enough. -->
  <ItemGroup Label="Friend assemblies by convention" Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <InternalsVisibleTo Include="$(MSBuildProjectName).Tests"/>
  </ItemGroup>

  <!-- The top-level folder of a project selects its profile. Ignoring case: the file system does, and a typed path keeps the case it was typed with. -->
  <PropertyGroup Label="Folder profiles">
    <_CheatEngineClientFolder>$([MSBuild]::MakeRelative('$(RepoRoot)', '$(MSBuildProjectDirectory)').Replace('\', '/'))/</_CheatEngineClientFolder>
  </PropertyGroup>
  <Import Project="$(RepoRoot)eng/Shipping.props"
          Condition="$(_CheatEngineClientFolder.StartsWith('src/', System.StringComparison.OrdinalIgnoreCase)) or $(_CheatEngineClientFolder.StartsWith('libs/', System.StringComparison.OrdinalIgnoreCase))"/>
  <Import Project="$(RepoRoot)eng/Tests.props"
          Condition="$(_CheatEngineClientFolder.StartsWith('tests/', System.StringComparison.OrdinalIgnoreCase))"/>
  <Import Project="$(RepoRoot)eng/Templates.props"
          Condition="$(_CheatEngineClientFolder.StartsWith('templates/', System.StringComparison.OrdinalIgnoreCase))"/>
</Project>
